load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:defs.bzl", "cc_library")

package(default_testonly = True)

cc_library(
    name = "global_stat_proxy_cases",
    srcs = ["test_global_stat_proxy.cpp"],
    alwayslink = True,
    deps = [
        "//bazel/third_party:gtest",
        "//src/share:cluster_metadata_persistence",
        "//src/share:cluster_topology",
        "//src/share:worker_runtime",
    ],
)

cc_test(
    name = "test_global_stat_proxy",
    size = "small",
    linkstatic = True,
    features = ["-static_cpp_runtime", "-static_link_cpp_runtimes"],
    deps = [
        ":global_stat_proxy_cases",
        "//src/observer:liboceanbase",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)
