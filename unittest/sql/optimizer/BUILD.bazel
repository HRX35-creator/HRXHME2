load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:defs.bzl", "cc_library")

package(default_testonly = True)

cc_library(
    name = "vector_filter_strategy_cases",
    srcs = ["test_vector_filter_strategy.cpp"],
    alwayslink = True,
    deps = [
        "//bazel/third_party:gtest",
        "//src/query:vector_index_interface",
        "//src/sql:hnsw_filter_test_headers",
    ],
)

cc_test(
    name = "test_vector_filter_strategy",
    size = "small",
    linkstatic = True,
    features = ["-static_cpp_runtime", "-static_link_cpp_runtimes"],
    deps = [
        ":vector_filter_strategy_cases",
        "//src/observer:liboceanbase",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)
