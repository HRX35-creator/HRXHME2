load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:defs.bzl", "cc_library")

package(default_testonly = True)

cc_library(
    name = "expr_uuid_node_cases",
    srcs = ["test_expr_uuid_node.cpp"],
    alwayslink = True,
    deps = [
        "//bazel/third_party:gtest",
        "//src/sql:expr_uuid_test_headers",
    ],
)

cc_test(
    name = "test_expr_uuid_node",
    size = "small",
    linkstatic = True,
    # liboceanbase supplies the C++ runtime; select rules_cc's $ORIGIN rpath.
    features = ["-static_cpp_runtime", "-static_link_cpp_runtimes"],
    deps = [
        ":expr_uuid_node_cases",
        "//src/observer:liboceanbase",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)
