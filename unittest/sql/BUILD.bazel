load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:defs.bzl", "cc_library")

package(default_testonly = True)

cc_library(
    name = "datum_collection_compare_cases",
    srcs = ["test_datum_collection_compare.cpp"],
    alwayslink = True,
    deps = [
        "//src/sql:sql_runtime_interface",
        "//src/sql:sql_runtime_internal_headers",
        "//bazel/third_party:gtest",
    ],
)

cc_test(
    name = "test_datum_collection_compare",
    linkstatic = True,
    data = ["//src/observer:liboceanbase_test_runtime"],
    env = {"LD_LIBRARY_PATH": "src/observer"},
    deps = [":datum_collection_compare_cases", "//src/observer:liboceanbase"],
)

cc_library(
