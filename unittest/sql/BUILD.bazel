        "//src/sql:sql_runtime_interface",
        "//src/sql:sql_runtime_internal_headers",
        "//bazel/third_party:gtest",
    ],
)

cc_test(
    name = "test_datum_parameter_constraints",
    linkstatic = True,
    data = ["data/physical_plan_context.golden", "//src/observer:liboceanbase_test_runtime"],
    env = {"LD_LIBRARY_PATH": "src/observer"},
