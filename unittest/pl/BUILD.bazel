cc_test(
    name = "test_datum_record_null",
    linkstatic = True,
    data = ["//src/observer:liboceanbase_test_runtime"],
    env = {"LD_LIBRARY_PATH": "src/observer"},
    deps = [":datum_record_null_cases", "//src/observer:liboceanbase"],
