DROP TABLE IF EXISTS fts_union_t;
CREATE TABLE fts_union_t (
id INT PRIMARY KEY,
cat INT NOT NULL,
zh VARCHAR(200),
en VARCHAR(200),
FULLTEXT INDEX ft_zh(zh) WITH PARSER ik,
FULLTEXT INDEX ft_en(en) WITH PARSER beng
);
INSERT INTO fts_union_t VALUES
(1, 1, '全文索引的分词器热路径优化', 'full text index tokenizer hot path'),
(2, 2, '倒排索引与检索系统设计', 'inverted index and retrieval design'),
(3, 1, '数据库性能优化实践', 'database performance tuning practice'),
(4, 3, '中文分词词典加载机制', 'dictionary loading for chinese tokenizer'),
(5, 2, 'OceanBase 是一款非常稳定的数据库', 'oceanbase is a very stable database'),
(6, 1, '分词器与倒排索引', 'tokenizer and inverted index'),
(7, 3, '搜索引擎召回率调优', 'search engine recall tuning'),
(8, 2, '全文检索 全文检索 全文检索', 'retrieval retrieval retrieval'),
(9, 1, '没有任何匹配的句子', 'nothing here matches'),
(10, 3, '索引 索引 分词', 'index index tokenizer');
SELECT COUNT(*) FROM fts_union_t WHERE MATCH(zh) AGAINST('全文索引 分词器');
COUNT(*)
2
SELECT COUNT(*) FROM fts_union_t WHERE MATCH(en) AGAINST('index tokenizer database');
COUNT(*)
7
SELECT COUNT(*) FROM fts_union_t WHERE MATCH(en) AGAINST('index index index');
COUNT(*)
4
SELECT COUNT(*) FROM fts_union_t WHERE MATCH(en) AGAINST('nosuchword anothermissingword');
COUNT(*)
0
SELECT COUNT(*), MIN(id), MAX(id), SUM(id) FROM fts_union_t WHERE MATCH(zh) AGAINST('索引 数据库 召回率');
COUNT(*)	MIN(id)	MAX(id)	SUM(id)
6	2	10	33
SELECT cat, COUNT(*) FROM fts_union_t WHERE MATCH(en) AGAINST('index tokenizer') GROUP BY cat ORDER BY cat;
cat	COUNT(*)
1	2
2	1
3	2
SELECT COUNT(*) FROM fts_union_t WHERE MATCH(en) AGAINST('index tokenizer') AND cat = 1;
COUNT(*)
2
SELECT COUNT(*) FROM (SELECT id FROM fts_union_t WHERE MATCH(en) AGAINST('index tokenizer database') LIMIT 3) t;
COUNT(*)
3
SELECT COUNT(*) FROM (SELECT id FROM fts_union_t WHERE MATCH(en) AGAINST('index tokenizer database') LIMIT 2 OFFSET 4) t;
COUNT(*)
2
SELECT id, ROUND(MATCH(en) AGAINST('index tokenizer'), 6) AS s FROM fts_union_t
WHERE MATCH(en) AGAINST('index tokenizer') ORDER BY s DESC, id LIMIT 3;
id	s
10	1.144851
6	0.974692
1	0.879342
