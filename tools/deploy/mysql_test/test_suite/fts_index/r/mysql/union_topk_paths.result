3
SELECT tokenize('中华人民共和国人民大会堂是著名地标', 'ik');
tokenize('中华人民共和国人民大会堂是著名地标', 'ik')
["著名", "人民大会堂", "地标", "是", "中华人民共和国"]
SELECT tokenize('中华人民共和国人民大会堂是著名地标', 'ik', '[{"additional_args":[{"ik_mode": "max_word"}]}]');
tokenize('中华人民共和国人民大会堂是著名地标', 'ik', '[{"additional_args":[{"ik_mode": "max_word"}]}]')
["大会", "著名", "人民大会堂", "大会堂", "共和国", "人民大会", "人民共和国", "中华人民", "共和", "地标", "是", "会堂", "中华", "中华人民共和国", "名地", "国人", "华人", "人民"]
SELECT tokenize('一二三四五六七八九十 2026年10月28日 三百五十元 ABC123def 。，、', 'ik');
tokenize('一二三四五六七八九十 2026年10月28日 三百五十元 ABC123def 。，、', 'ik')
["abc123def", "28日", "2026年", "10月", "一二三四五六七八九十", "三百五十元"]
SELECT tokenize('全文索引的分词器热路径优化包括解析器实例复用、停用词全局单例', 'ik', '[{"additional_args":[{"ik_mode": "max_word"}]}]');
tokenize('全文索引的分词器热路径优化包括解析器实例复用、停用词全局单例', 'ik', '[{"additional_args":[{"ik_mode": "max_word"}]}]')
["器", "停用", "包括", "例", "解析", "用词", "复用", "索引", "分词器", "单", "优化", "全文", "路径", "全局", "分词", "解析器", "全文索引", "实例", "的", "热"]
DROP TABLE fts_union_t;
