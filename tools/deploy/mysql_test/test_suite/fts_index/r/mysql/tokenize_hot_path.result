DROP TABLE IF EXISTS fts_hot_path;
CREATE TABLE fts_hot_path (
id INT PRIMARY KEY,
zh TEXT,
en TEXT
) DEFAULT CHARSET=utf8mb4;
INSERT INTO fts_hot_path VALUES
(1, 'OceanBase数据库全文索引 1.2亿 ABC123', 'THE database database quick brown fox'),
