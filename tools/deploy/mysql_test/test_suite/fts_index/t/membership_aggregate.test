term0264 uniqueterm0265 uniqueterm0266 uniqueterm0267 uniqueterm0268 uniqueterm0269 uniqueterm0270 uniqueterm0271 uniqueterm0272 uniqueterm0273 uniqueterm0274 uniqueterm0275 uniqueterm0276 uniqueterm0277 uniqueterm0278 uniqueterm0279 uniqueterm0280 uniqueterm0281 uniqueterm0282 uniqueterm0283 uniqueterm0284 uniqueterm0285 uniqueterm0286 uniqueterm0287 uniqueterm0288 uniqueterm0289 uniqueterm0290 uniqueterm0291 uniqueterm0292 uniqueterm0293 uniqueterm0294 uniqueterm0295 uniqueterm0296 uniqueterm0297 uniqueterm0298 uniqueterm0299';
EXECUTE membership_query USING @long_query;
SET @long_query = CONCAT(@long_query, ' database audit');
EXECUTE membership_query USING @long_query;
--enable_query_log
DEALLOCATE PREPARE membership_query;

START TRANSACTION;
DELETE FROM membership_aggregate WHERE id = 1;
SELECT COUNT(*) FROM membership_aggregate WHERE MATCH(body) AGAINST('database audit');
ROLLBACK;
SELECT COUNT(*) FROM membership_aggregate WHERE MATCH(body) AGAINST('database audit');
UPDATE membership_aggregate SET body = 'audit database' WHERE id = 4;
SELECT COUNT(*) FROM membership_aggregate WHERE MATCH(body) AGAINST('database audit');
DROP TABLE membership_aggregate;
