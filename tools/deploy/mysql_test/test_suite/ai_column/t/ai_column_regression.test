# Composite keys, stored procedures, NULL results, and strict-read isolation.
connection default;
--exec python3 mysql_test/test_suite/ai_column/include/ai_column_mock.py start 19124
--disable_warnings
drop database if exists ai_column_regression;
--enable_warnings
create database ai_column_regression;
--error 0,11112
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('regression_ep');
--error 0,11118
call DBMS_AI_SERVICE.DROP_AI_MODEL('regression_model');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('regression_model',
  '{"type":"completion","model_name":"mock-complete"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('regression_ep',
  '{"ai_model_name":"regression_model","url":"http://127.0.0.1:19124/v1/chat/completions","access_key":"regression-key","provider":"openai"}');
--error 0,11112
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('regression_embed_ep');
--error 0,11118
call DBMS_AI_SERVICE.DROP_AI_MODEL('regression_embed');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('regression_embed',
  '{"type":"dense_embedding","model_name":"mock-embed"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('regression_embed_ep',
  '{"ai_model_name":"regression_embed","url":"http://127.0.0.1:19124/v1/embeddings","access_key":"regression-key","provider":"openai"}');
create table ai_column_regression.docs(
  tenant int,
  id varchar(40),
  content text,
  category int,
  result varchar(400) AI COLUMN (AI_COMPLETE('regression_model', content))
    WITH (sync_mode='async', max_retries=0),
  primary key(tenant, id)
);

delimiter |;
create procedure ai_column_regression.add_doc()
begin
  insert into ai_column_regression.docs(tenant, id, content, category)
    values(7, '引号''键', 'row-one', 0);
end|
create procedure ai_column_regression.overwrite_result()
begin
  update ai_column_regression.docs set result = 'forbidden' where tenant = 7;
end|
delimiter ;|
call ai_column_regression.add_doc();
let $retry = 150;
let $ready = 0;
while ($retry)
{
  let $ready = `select count(*) = 1 from ai_column_regression.docs where result is not null`;
  if ($ready == 1) { let $retry = 0; }
  if ($ready == 0) { --real_sleep 0.1
    dec $retry; }
}
eval select $ready = 1 as procedure_insert_generates_result;
--error 1235
call ai_column_regression.overwrite_result();
select result <> 'forbidden' as procedure_cannot_assign_result from ai_column_regression.docs;

# Existing rows are backfilled, and changing the definition generates a new result.
alter table ai_column_regression.docs add column label varchar(400)
  AI COLUMN (AI_COMPLETE('regression_model', concat('Label: ', content))) WITH(max_retries=0);
let $retry = 150;
let $ready = 0;
while ($retry)
{
  let $ready = `select count(*) = 1 from ai_column_regression.docs where label = 'mock:Label: row-one'`;
  if ($ready == 1) { let $retry = 0; }
  if ($ready == 0) { --real_sleep 0.1
    dec $retry; }
}
eval select $ready = 1 as added_column_backfilled;
alter table ai_column_regression.docs modify column label varchar(400)
  AI COLUMN (AI_COMPLETE('regression_model', concat('New: ', content))) WITH(max_retries=0);
let $retry = 150;
let $ready = 0;
while ($retry)
{
  let $ready = `select count(*) = 1 from ai_column_regression.docs where label = 'mock:New: row-one'`;
  if ($ready == 1) { let $retry = 0; }
  if ($ready == 0) { --real_sleep 0.1
    dec $retry; }
}
eval select $ready = 1 as modified_definition_recomputed;

# A successfully evaluated NULL is READY and causes no HTTP request.
--exec python3 mysql_test/test_suite/ai_column/include/ai_column_mock.py reset 19124
create table ai_column_regression.null_docs(
  id int primary key,
  content text,
  result vector(4) AI COLUMN (AI_EMBED('regression_embed', content))
    WITH (sync_mode='async', max_retries=0)
);
insert into ai_column_regression.null_docs(id, content) values(8, null);
let $retry = 100;
let $tasks = 1;
while ($retry)
{
  let $tasks = `select count(*) from oceanbase.__all_ai_column_task task
    join oceanbase.__all_table t on t.table_id = task.table_id
    join oceanbase.__all_database d on d.database_id = t.database_id
    where d.database_name = 'ai_column_regression'`;
  if ($tasks == 0) { let $retry = 0; }
  if ($tasks != 0) { --real_sleep 0.1
    dec $retry; }
}
eval select $tasks = 0 as null_result_task_completed;
set session ai_column_strict_read = on;
select result is null as ready_null_is_readable from ai_column_regression.null_docs where id = 8;
--exec python3 mysql_test/test_suite/ai_column/include/ai_column_mock.py assert 19124 no-requests

# Ordinary-column statements remain usable while another AI column is pending.
--exec python3 mysql_test/test_suite/ai_column/include/ai_column_mock.py stop 19124
update ai_column_regression.docs set content = 'changed' where tenant = 7;
update ai_column_regression.docs set category = 9 where tenant = 7;
select category = 9 as ordinary_update_under_strict_read from ai_column_regression.docs where tenant = 7;
--replace_regex /table_id=[0-9]+, column_id=[0-9]+/table_id=<table_id>, column_id=<column_id>/
--error 11120
select result from ai_column_regression.docs limit 0;
set session ai_column_strict_read = off;
drop database ai_column_regression;
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('regression_ep');
call DBMS_AI_SERVICE.DROP_AI_MODEL('regression_model');
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('regression_embed_ep');
call DBMS_AI_SERVICE.DROP_AI_MODEL('regression_embed');
