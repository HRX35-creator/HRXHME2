drop table if exists t_ai_enhance;
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('ai_enhance_ep_completion');
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('ai_enhance_ep_embedding');
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('ai_enhance_ep_rerank');
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('ai_enhance_ep_ollama_completion');
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('ai_enhance_ep_ollama_embedding');
call DBMS_AI_SERVICE.DROP_AI_MODEL('ai_enhance_completion');
call DBMS_AI_SERVICE.DROP_AI_MODEL('ai_enhance_embedding');
call DBMS_AI_SERVICE.DROP_AI_MODEL('ai_enhance_rerank');
call DBMS_AI_SERVICE.DROP_AI_MODEL('ai_enhance_ollama_completion');
call DBMS_AI_SERVICE.DROP_AI_MODEL('ai_enhance_ollama_embedding');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('ai_enhance_completion', '{"type": "completion", "model_name": "mock-completion"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('ai_enhance_embedding', '{"type": "dense_embedding", "model_name": "mock-embedding"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('ai_enhance_rerank', '{"type": "rerank", "model_name": "mock-rerank"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('ai_enhance_ollama_completion', '{"type": "completion", "model_name": "mock-ollama-completion"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('ai_enhance_ollama_embedding', '{"type": "dense_embedding", "model_name": "mock-ollama-embedding"}');
select NAME, TYPE, MODEL_NAME from oceanbase.DBA_OB_AI_MODELS where NAME = 'ai_enhance_completion';
NAME	TYPE	MODEL_NAME
ai_enhance_completion	COMPLETION	mock-completion
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('ai_enhance_ep_completion', '{"ai_model_name": "ai_enhance_completion", "url": "http://127.0.0.1:8000/v1/chat/completions", "access_key": "sk-test", "provider": "openai"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('ai_enhance_ep_embedding', '{"ai_model_name": "ai_enhance_embedding", "url": "http://127.0.0.1:8000/v1/embeddings", "access_key": "sk-test", "provider": "openai"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('ai_enhance_ep_rerank', '{"ai_model_name": "ai_enhance_rerank", "url": "http://127.0.0.1:8000/v1/rerank", "access_key": "sk-test", "provider": "siliconflow"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('ai_enhance_ep_ollama_completion', '{"ai_model_name": "ai_enhance_ollama_completion", "url": "http://127.0.0.1:8000/api/generate", "provider": "ollama"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('ai_enhance_ep_ollama_embedding', '{"ai_model_name": "ai_enhance_ollama_embedding", "url": "http://127.0.0.1:8000/api/embeddings", "provider": "ollama"}');
call DBMS_AI_SERVICE.ALTER_AI_MODEL_ENDPOINT('ai_enhance_ep_ollama_completion', '{"provider" : "OLLAMA"}');
call DBMS_AI_SERVICE.ALTER_AI_MODEL_ENDPOINT('ai_enhance_ep_completion', '{"provider" : "no_such_provider"}');
ERROR HY000: The value of param 'provider' is invalid
call DBMS_AI_SERVICE.ALTER_AI_MODEL_ENDPOINT('ai_enhance_ep_ollama_completion', '{"provider" : "openai"}');
ERROR HY000: The param 'access_key' is empty or null
select ai_complete();
ERROR 42000: Incorrect parameter count in the call to native function 'ai_complete'
select ai_complete('ai_enhance_completion', 'hello', '{}', '{}');
ERROR 42000: Incorrect parameter count in the call to native function 'ai_complete'
select ai_embed('ai_enhance_embedding');
ERROR 42000: Incorrect parameter count in the call to native function 'ai_embed'
select ai_embed('ai_enhance_embedding', 'hello', 4, 4);
ERROR 42000: Incorrect parameter count in the call to native function 'ai_embed'
select ai_rerank('ai_enhance_rerank', 'query');
ERROR 42000: Incorrect parameter count in the call to native function 'ai_rerank'
