r
NULL
select ai_embed('', 'hello');
ERROR HY000: Incorrect arguments to ai_embed, model id or input is empty
select ai_embed('ai_enhance_embedding', '');
ERROR HY000: Incorrect arguments to ai_embed, model id or input is empty
select ai_embed('ai_enhance_embedding', 'hello', 0);
