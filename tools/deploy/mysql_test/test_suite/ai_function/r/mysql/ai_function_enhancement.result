select ai_rerank('ai_enhance_rerank', 'query', json_array());
ERROR HY000: Incorrect arguments to ai_rerank, document_array is empty
select ai_rerank('ai_enhance_rerank', 'query', json_object('a', 'b'));
ERROR HY000: Incorrect arguments to ai_rerank, document_array is not array
select ai_rerank('ai_enhance_rerank', 'query', json_array(1, 2));
ERROR HY000: Incorrect arguments to ai_rerank, document_array element is not string
select ai_rerank('ai_enhance_rerank', 'query', json_array(json_object('id', 1)), 'text');
ERROR HY000: Incorrect arguments to ai_rerank, the value for given doc key is null
